   "default": "(WGS84)",
   "values": "行星模型 Earth (WGS84) (default) | Custom",
   "group": ""
  },
  {
   "name": "Flattening",
   "default": "1/298.257223563",
   "values": "行星扁率 1/298.257223563 (default) | scalar",
   "group": ""
  },
  {
   "name": "Equatorial radius of planet",
