%endfunction

%function EvPowertrainController2_minimum_Fcn1(block) void
%assign fcnBuff = ""
%openfile fcnBuff
%assign cfgTxt = ""
%openfile cfgTxt
int32_T b_idx;
int32_T k;
if (!rtIsNaN(x[0])) {
    b_idx = 1;
} else {
    boolean_T exitg1;
    b_idx = 0;
    k = 2;
    exitg1 = false;
    while ((!exitg1) && (k < 202)) {
        if (!rtIsNaN(x[k - 1])) {
            b_idx = k;
            exitg1 = true;
        } else {
            k++;
        }
    }
}
if (b_idx == 0) {
    *ex = x[0];
    *idx = 1;
} else {
    *ex = x[b_idx - 1];
    *idx = b_idx;
    for (k = b_idx + 1; k < 202; k++) {
        real_T x_0;
        x_0 = x[k - 1];
        if (*ex > x_0) {
            *ex = x_0;
            *idx = k;
        }
    }
}
%closefile cfgTxt
%<cfgTxt>
%closefile fcnBuff
%assign fcnProtoType = ""
%openfile fcnProtoType
