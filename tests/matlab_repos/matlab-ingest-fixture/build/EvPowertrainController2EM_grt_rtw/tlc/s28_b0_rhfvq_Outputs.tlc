%<SLibCG_TrackEI(2)>\
%<SLibCG_TrackEI(1)>\
%<SLibCG_TrackEI(0)>\
/* {S!d42}Outport: '<Root>/EngTrqCmd' incorporates:
 *  Constant: '<Root>/Constant1'
 */
EvPowertrainController2EM_Y.EngTrqCmd = EvPowertrainController2EM_P.Constant1_Value_gn;
/* {S!d44}Product: '<S4>/Product' incorporates:
 *  Gain: '<S4>/Gain1'
 *  Inport: '<Root>/BMSDischrgCurrLmt'
 *  Inport: '<Root>/BattPackVolt'
 */
rtb_Product = EvPowertrainController2EM_P.Gain1_Gain_i * EvPowertrainController2EM_U.BMSDischrgCurrLmt * EvPowertrainController2EM_U.BattPackVolt;
/* {S!d46}Product: '<S4>/Product1' incorporates:
 *  Gain: '<S4>/Gain'
 *  Inport: '<Root>/BMSChrgCurrLmt'
 *  Inport: '<Root>/BattPackVolt'
 */
rtb_Product1 = EvPowertrainController2EM_P.Gain_Gain_e * EvPowertrainController2EM_U.BMSChrgCurrLmt * EvPowertrainController2EM_U.BattPackVolt;
/* {S!d27}Outputs for Atomic SubSystem: '<Root>/Energy Management' */
/* {S!d48}Lookup_n-D: '<S28>/MaxEMTrqVsSpd' incorporates:
 *  Inport: '<Root>/EMSpd'
 */
rtb_Gain1_n = look1_binlcapw(EvPowertrainController2EM_U.EMSpd[0], EvPowertrainController2EM_P.PlntEM1Spd, EvPowertrainController2EM_P.PlntEM1Trq, 13U);
/* {S!d50}Switch: '<S31>/Switch2' incorporates:
 *  Constant: '<S31>/Constant1'
 *  Constant: '<S31>/Constant2'
 *  Inport: '<Root>/EMSpd'
 *  Product: '<S31>/Product1'
 */
if (rtb_Gain1_n * EvPowertrainController2EM_U.EMSpd[0] >= EvPowertrainController2EM_P.Switch2_Threshold_g) {
    rtb_UnitDelay2 = EvPowertrainController2EM_P.Constant1_Value;
} else {
    rtb_UnitDelay2 = EvPowertrainController2EM_P.Constant2_Value;
}
/* {E!d50}End of Switch: '<S31>/Switch2' */

/* {S!d52}Math: '<S31>/Math Function1' incorporates:
 *  Constant: '<S16>/Constant'
 *  Constant: '<S31>/Constant'
 *  Constant: '<S38>/Constant'
 *  Constant: '<S43>/Constant'
 *  Math: '<S16>/Math Function1'
 *  Math: '<S38>/Math Function1'
 *  Math: '<S43>/Math Function1'
 *  Switch: '<S21>/Accel Decel Switch'
 */
rtb_WhlEMTrqMax_tmp = EvPowertrainController2EM_P.PlntDiffrntlEff * EvPowertrainController2EM_P.PlntEM1TransEff;
if ((rtb_WhlEMTrqMax_tmp < 0.0) && (rtb_UnitDelay2 > floor(rtb_UnitDelay2))) {
    rtb_BrkTrqReqTotal_tmp = -%<(SLibCGCallSubFcn("rt_powd_snf", ["-rtb_WhlEMTrqMax_tmp", "rtb_UnitDelay2"], 0, 4, 18))>;
} else {
    rtb_BrkTrqReqTotal_tmp = %<(SLibCGCallSubFcn("rt_powd_snf", ["rtb_WhlEMTrqMax_tmp", "rtb_UnitDelay2"], 0, 4, 5))>;
}
/* {S!d54}Gain: '<S30>/Gain3' incorporates:
 *  Gain: '<S15>/Gain3'
 *  Gain: '<S19>/Gain1'
 *  Gain: '<S37>/Gain3'
 *  Gain: '<S69>/Gain3'
 *  Switch: '<S21>/Accel Decel Switch'
 */
rtb_RateLimiter_idx_0_tmp = EvPowertrainController2EM_P.PlntDiffrntlRatio * EvPowertrainController2EM_P.PlntEM1TransGearRatio;
/* {S!d56}Product: '<S30>/Divide2' incorporates:
 *  Gain: '<S30>/Gain3'
 *  Math: '<S31>/Math Function1'
 */
rtb_RateLimiter_idx_0 = rtb_RateLimiter_idx_0_tmp * rtb_Gain1_n * rtb_BrkTrqReqTotal_tmp;
/* {S!d58}Lookup_n-D: '<S29>/MaxEMTrqVsSpd' incorporates:
 *  Inport: '<Root>/EMSpd'
 */
rtb_UnitDelay2 = look1_binlcapw(EvPowertrainController2EM_U.EMSpd[1], EvPowertrainController2EM_P.PlntEM2Spd, EvPowertrainController2EM_P.PlntEM2Trq, 13U);
/* {S!d60}Switch: '<S33>/Switch2' incorporates:
 *  Constant: '<S33>/Constant1'
 *  Constant: '<S33>/Constant2'
 *  Inport: '<Root>/EMSpd'
 *  Product: '<S33>/Product1'
 */
if (rtb_UnitDelay2 * EvPowertrainController2EM_U.EMSpd[1] >= EvPowertrainController2EM_P.Switch2_Threshold_h) {
    rtb_Gain1_n = EvPowertrainController2EM_P.Constant1_Value_g;
} else {
    rtb_Gain1_n = EvPowertrainController2EM_P.Constant2_Value_j;
}
/* {E!d60}End of Switch: '<S33>/Switch2' */

/* {S!d62}Math: '<S33>/Math Function1' incorporates:
 *  Constant: '<S33>/Constant'
 *  Constant: '<S40>/Constant'
 *  Constant: '<S44>/Constant'
 *  Constant: '<S83>/Constant'
 *  Math: '<S40>/Math Function1'
 *  Math: '<S44>/Math Function1'
 *  Math: '<S83>/Math Function1'
 */
rtb_WhlEMTrqMax_tmp_0 = EvPowertrainController2EM_P.PlntDiffrntl2Eff * EvPowertrainController2EM_P.PlntEM2TransEff;
if ((rtb_WhlEMTrqMax_tmp_0 < 0.0) && (rtb_Gain1_n > floor(rtb_Gain1_n))) {
    rtb_BrkTrqReqTotal_tmp = -%<(SLibCGCallSubFcn("rt_powd_snf", ["-rtb_WhlEMTrqMax_tmp_0", "rtb_Gain1_n"], 0, 4, 19))>;
} else {
    rtb_BrkTrqReqTotal_tmp = %<(SLibCGCallSubFcn("rt_powd_snf", ["rtb_WhlEMTrqMax_tmp_0", "rtb_Gain1_n"], 0, 4, 6))>;
}
/* {S!d64}Gain: '<S32>/Gain3' incorporates:
 *  Gain: '<S17>/Gain3'
 *  Gain: '<S19>/Gain2'
 *  Gain: '<S39>/Gain3'
 *  Gain: '<S82>/Gain3'
 *  Switch: '<S21>/Accel Decel Switch'
 */
rtb_RateLimiter_idx_1_tmp = EvPowertrainController2EM_P.PlntDiffrntl2Ratio * EvPowertrainController2EM_P.PlntEM2TransGearRatio;
/* {S!d66}Product: '<S32>/Divide2' incorporates:
 *  Gain: '<S32>/Gain3'
 *  Math: '<S33>/Math Function1'
 */
rtb_RateLimiter_idx_1 = rtb_RateLimiter_idx_1_tmp * rtb_UnitDelay2 * rtb_BrkTrqReqTotal_tmp;
/* {S!d68}Product: '<S41>/Product5' incorporates:
 *  Constant: '<S41>/Front Brakes'
 *  Product: '<S41>/Product2'
 */
rtb_BrkTrqReqTotal = EvPowertrainController2EM_P.PlntBrkKinFricCffFrnt * 3.1415926535897931 * 0.0025000000000000005 * EvPowertrainController2EM_P.PlntBrkPadMeanRadiusFrnt * EvPowertrainController2EM_P.PlntBrkNumPadsFrnt / 4.0;
/* {S!d70}Product: '<S41>/Product3' incorporates:
 *  Constant: '<S41>/Rear Brakes'
 *  Product: '<S41>/Product1'
 */
rtb_BrkTrqReqTotal_tmp = EvPowertrainController2EM_P.PlntBrkKinFricCffRear * 3.1415926535897931 * 0.0025000000000000005 * EvPowertrainController2EM_P.PlntBrkPadMeanRadiusRear * EvPowertrainController2EM_P.PlntBrkNumPadsRear / 4.0;
/* {S!d72}Sum: '<S41>/Add' incorporates:
 *  Constant: '<S2>/Front Bias'
 *  Constant: '<S2>/Rear Bias'
 *  Constant: '<S41>/Front Brakes'
 *  Constant: '<S41>/Rear Brakes'
 *  Gain: '<S2>/Gain4'
 *  Inport: '<Root>/BcuBrkPrsCmd'
 *  Product: '<S2>/Product'
 *  Product: '<S41>/Product1'
 *  Product: '<S41>/Product2'
 *  Product: '<S41>/Product3'
 *  Product: '<S41>/Product5'
 */
rtb_BrkTrqReqTotal = ((EvPowertrainController2EM_P.PlntBrkFrntBias * EvPowertrainController2EM_U.BcuBrkPrsCmd[0] * EvPowertrainController2EM_P.PlntBrkPrsFctr * rtb_BrkTrqReqTotal + EvPowertrainController2EM_P.PlntBrkFrntBias * EvPowertrainController2EM_U.BcuBrkPrsCmd[1] * EvPowertrainController2EM_P.PlntBrkPrsFctr * rtb_BrkTrqReqTotal) + EvPowertrainController2EM_P.PlntBrkRearBias * EvPowertrainController2EM_U.BcuBrkPrsCmd[2] * EvPowertrainController2EM_P.PlntBrkPrsFctr * rtb_BrkTrqReqTotal_tmp) + EvPowertrainController2EM_P.PlntBrkRearBias * EvPowertrainController2EM_U.BcuBrkPrsCmd[3] * EvPowertrainController2EM_P.PlntBrkPrsFctr * rtb_BrkTrqReqTotal_tmp;
/* {S!d92}Switch: '<S21>/Accel Decel Switch' incorporates:
 *  Gain: '<S15>/Gain3'
 *  Gain: '<S36>/Gain1'
 *  Gain: '<S5>/convert2percent'
 *  Inport: '<Root>/AccelPdl'
 *  Inport: '<Root>/BMSSOC'
 *  Inport: '<Root>/VehSpdFdbk'
 *  Lookup_n-D: '<S36>/ChrgLmt'
 *  Lookup_n-D: '<S36>/RegenBrakingCutoff'
 *  Math: '<S16>/Math Function1'
 *  MinMax: '<S36>/MinMax'
 *  Product: '<S15>/Divide2'
 *  Product: '<S17>/Divide2'
 *  Product: '<S1>/Product1'
 *  Product: '<S36>/Product1'
 *  Product: '<S36>/Product3'
 *  Sum: '<S36>/Sum of Elements'
 *  Sum: '<S9>/Add'
 */
if (EvPowertrainController2EM_U.AccelPdl > EvPowertrainController2EM_P.AccelDecelSwitch_Threshold) {
    /* {S!d74}Gain: '<S19>/Gain2' incorporates:
 *  Gain: '<S19>/Gain4'
 *  Inport: '<Root>/VehSpdFdbk'
 */
    rtb_RegenFactor = 1.0 / EvPowertrainController2EM_P.PlntWhlLdRadiusRear * EvPowertrainController2EM_U.VehSpdFdbk * rtb_RateLimiter_idx_1_tmp;
    /* {S!d76}Lookup_n-D: '<S13>/MaxEMTrqVsSpd' incorporates:
 *  Lookup_n-D: '<S12>/MaxEMTrqVsSpd'
 */
    rtb_Gain1_n = look1_binlcapw(rtb_RegenFactor, EvPowertrainController2EM_P.PlntEM2Spd, EvPowertrainController2EM_P.PlntEM2Trq, 13U);
    /* {S!d78}Gain: '<S17>/Gain3' */
    rtb_whlpureelectrictraction = rtb_RateLimiter_idx_1_tmp * rtb_Gain1_n;
    /* {S!d80}Switch: '<S18>/Switch2' incorporates:
 *  Constant: '<S18>/Constant1'
 *  Constant: '<S18>/Constant2'
 *  Product: '<S18>/Product1'
 */
    if (rtb_Gain1_n * rtb_RegenFactor >= EvPowertrainController2EM_P.Switch2_Threshold) {
        rtb_Gain1_n = EvPowertrainController2EM_P.Constant1_Value_kl;
    } else {
        rtb_Gain1_n = EvPowertrainController2EM_P.Constant2_Value_b;
    }
    /* {E!d80}End of Switch: '<S18>/Switch2' */

    /* {S!d82}Math: '<S18>/Math Function1' incorporates:
 *  Constant: '<S33>/Constant'
 *  Math: '<S33>/Math Function1'
 */
    if ((rtb_WhlEMTrqMax_tmp_0 < 0.0) && (rtb_Gain1_n > floor(rtb_Gain1_n))) {
        rtb_UnitDelay2 = -%<(SLibCGCallSubFcn("rt_powd_snf", ["-rtb_WhlEMTrqMax_tmp_0", "rtb_Gain1_n"], 0, 4, 20))>;
    } else {
        rtb_UnitDelay2 = %<(SLibCGCallSubFcn("rt_powd_snf", ["rtb_WhlEMTrqMax_tmp_0", "rtb_Gain1_n"], 0, 4, 4))>;
    }
    /* {E!d82}End of Math: '<S18>/Math Function1' */

    /* {S!d84}Gain: '<S19>/Gain1' incorporates:
 *  Gain: '<S19>/Gain3'
 *  Inport: '<Root>/VehSpdFdbk'
 */
    rtb_Gain1_n = 1.0 / EvPowertrainController2EM_P.PlntWhlLdRadiusFrnt * EvPowertrainController2EM_U.VehSpdFdbk * rtb_RateLimiter_idx_0_tmp;
    /* {S!d86}Lookup_n-D: '<S12>/MaxEMTrqVsSpd' incorporates:
 *  Math: '<S16>/Math Function1'
 */
    rtb_RegenFactor = look1_binlcapw(rtb_Gain1_n, EvPowertrainController2EM_P.PlntEM1Spd, EvPowertrainController2EM_P.PlntEM1Trq, 13U);
    /* {S!d88}Switch: '<S16>/Switch2' incorporates:
 *  Constant: '<S16>/Constant1'
 *  Constant: '<S16>/Constant2'
 *  Product: '<S16>/Product1'
 */
    if (rtb_RegenFactor * rtb_Gain1_n >= EvPowertrainController2EM_P.Switch2_Threshold_l) {
        rtb_Gain1_n = EvPowertrainController2EM_P.Constant1_Value_k;
    } else {
        rtb_Gain1_n = EvPowertrainController2EM_P.Constant2_Value_jm;
    }
    /* {E!d88}End of Switch: '<S16>/Switch2' */

    /* {S!d90}Math: '<S16>/Math Function1' */
    if ((rtb_WhlEMTrqMax_tmp < 0.0) && (rtb_Gain1_n > floor(rtb_Gain1_n))) {
        rtb_BrkTrqReqTotal_tmp = -%<(SLibCGCallSubFcn("rt_powd_snf", ["-rtb_WhlEMTrqMax_tmp", "rtb_Gain1_n"], 0, 4, 23))>;
    } else {
        rtb_BrkTrqReqTotal_tmp = %<(SLibCGCallSubFcn("rt_powd_snf", ["rtb_WhlEMTrqMax_tmp", "rtb_Gain1_n"], 0, 4, 11))>;
    }
    rtb_whlpureelectrictraction = (rtb_RateLimiter_idx_0_tmp * rtb_RegenFactor * rtb_BrkTrqReqTotal_tmp + rtb_UnitDelay2 * rtb_whlpureelectrictraction) * EvPowertrainController2EM_U.AccelPdl;
} else {
    rtb_whlpureelectrictraction = look1_binlcapw(EvPowertrainController2EM_P.convert2percent_Gain * EvPowertrainController2EM_U.BMSSOC, EvPowertrainController2EM_P.CtrlVcuEvSocBpt, EvPowertrainController2EM_P.CtrlVcuEvChrgLmtBpt, 10U) * look1_binlcapw(EvPowertrainController2EM_U.VehSpdFdbk, EvPowertrainController2EM_P.CtrlVcuEvRegenBrkSpdBpt, EvPowertrainController2EM_P.CtrlVcuEvRegenBrkCutOff, 1U) * fmin(rtb_BrkTrqReqTotal, rtb_RateLimiter_idx_0 + rtb_RateLimiter_idx_1) * EvPowertrainController2EM_P.Gain1_Gain;
}
for (i = 0; i < 200; i++) {
    /* {S!d106}Switch: '<S21>/Accel Decel Switch1' incorporates:
 *  Constant: '<S39>/EMTrq Control Vector Traction'
 *  Gain: '<S39>/Gain'
 *  Gain: '<S39>/Gain3'
 *  Inport: '<Root>/AccelPdl'
 *  Math: '<S40>/Math Function1'
 *  Product: '<S39>/Divide2'
 */
    if (EvPowertrainController2EM_U.AccelPdl > EvPowertrainController2EM_P.AccelDecelSwitch1_Threshold) {
        /* {S!d94}Product: '<S40>/Product1' incorporates:
 *  Constant: '<S39>/EMTrq Control Vector Traction'
 */
        rtb_RegenFactor = EvPowertrainController2EM_P.EMTrqControlVectorTraction_Valu[i];
        /* {S!d96}Switch: '<S40>/Switch2' incorporates:
 *  Constant: '<S39>/EMTrq Control Vector Traction'
 *  Constant: '<S40>/Constant1'
 *  Constant: '<S40>/Constant2'
 *  Inport: '<Root>/EMSpd'
 *  Product: '<S40>/Product1'
 *  SignalConversion generated from: '<S25>/Vector Concatenate1'
 */
        if (rtb_RegenFactor * EvPowertrainController2EM_U.EMSpd[1] >= EvPowertrainController2EM_P.Switch2_Threshold_k) {
            rtb_BrkTrqReqTotal_tmp = EvPowertrainController2EM_P.Constant1_Value_ky;
        } else {
            rtb_BrkTrqReqTotal_tmp = EvPowertrainController2EM_P.Constant2_Value_bd;
        }
        /* {S!d98}Math: '<S40>/Math Function1' */
        if ((rtb_WhlEMTrqMax_tmp_0 < 0.0) && (rtb_BrkTrqReqTotal_tmp > floor(rtb_BrkTrqReqTotal_tmp))) {
            rtb_BrkTrqReqTotal_tmp = -%<(SLibCGCallSubFcn("rt_powd_snf", ["-rtb_WhlEMTrqMax_tmp_0", "rtb_BrkTrqReqTotal_tmp"], 0, 4, 22))>;
        } else {
            rtb_BrkTrqReqTotal_tmp = %<(SLibCGCallSubFcn("rt_powd_snf", ["rtb_WhlEMTrqMax_tmp_0", "rtb_BrkTrqReqTotal_tmp"], 0, 4, 8))>;
        }
        rtb_VectorConcatenate_i[i + 1] = rtb_RateLimiter_idx_1_tmp * rtb_RegenFactor * rtb_BrkTrqReqTotal_tmp;
    } else {
        /* {S!d100}Product: '<S40>/Product1' incorporates:
 *  Constant: '<S39>/EMTrq Control Vector Traction'
 */
        rtb_RegenFactor = EvPowertrainController2EM_P.EMTrqControlVectorTraction_Valu[i];
        /* {S!d102}Switch: '<S40>/Switch2' incorporates:
 *  Constant: '<S39>/EMTrq Control Vector Traction'
 *  Constant: '<S40>/Constant1'
 *  Constant: '<S40>/Constant2'
 *  Inport: '<Root>/EMSpd'
 *  Product: '<S40>/Product1'
 *  SignalConversion generated from: '<S25>/Vector Concatenate1'
 */
        if (rtb_RegenFactor * EvPowertrainController2EM_U.EMSpd[1] >= EvPowertrainController2EM_P.Switch2_Threshold_k) {
            rtb_BrkTrqReqTotal_tmp = EvPowertrainController2EM_P.Constant1_Value_ky;
        } else {
            rtb_BrkTrqReqTotal_tmp = EvPowertrainController2EM_P.Constant2_Value_bd;
        }
        /* {S!d104}Math: '<S40>/Math Function1' */
        if ((rtb_WhlEMTrqMax_tmp_0 < 0.0) && (rtb_BrkTrqReqTotal_tmp > floor(rtb_BrkTrqReqTotal_tmp))) {
            rtb_BrkTrqReqTotal_tmp = -%<(SLibCGCallSubFcn("rt_powd_snf", ["-rtb_WhlEMTrqMax_tmp_0", "rtb_BrkTrqReqTotal_tmp"], 0, 4, 21))>;
        } else {
            rtb_BrkTrqReqTotal_tmp = %<(SLibCGCallSubFcn("rt_powd_snf", ["rtb_WhlEMTrqMax_tmp_0", "rtb_BrkTrqReqTotal_tmp"], 0, 4, 7))>;
        }
        rtb_VectorConcatenate_i[i + 1] = rtb_RateLimiter_idx_1_tmp * rtb_RegenFactor * rtb_BrkTrqReqTotal_tmp * EvPowertrainController2EM_P.Gain_Gain;
    }
    /* {E!d106}End of Switch: '<S21>/Accel Decel Switch1' */

    /* {S!d120}Switch: '<S21>/Accel Decel Switch2' incorporates:
 *  Constant: '<S37>/EMTrq Control Vector Traction'
 *  Gain: '<S37>/Gain'
 *  Gain: '<S37>/Gain3'
 *  Inport: '<Root>/AccelPdl'
 *  Math: '<S38>/Math Function1'
 *  Product: '<S37>/Divide2'
 */
    if (EvPowertrainController2EM_U.AccelPdl > EvPowertrainController2EM_P.AccelDecelSwitch2_Threshold) {
        /* {S!d108}Product: '<S38>/Product1' incorporates:
 *  Constant: '<S37>/EMTrq Control Vector Traction'
 */
        rtb_RegenFactor = EvPowertrainController2EM_P.EMTrqControlVectorTraction_Va_j[i];
        /* {S!d110}Switch: '<S38>/Switch2' incorporates:
 *  Constant: '<S37>/EMTrq Control Vector Traction'
 *  Constant: '<S38>/Constant1'
 *  Constant: '<S38>/Constant2'
 *  Inport: '<Root>/EMSpd'
 *  Product: '<S38>/Product1'
 *  SignalConversion generated from: '<S25>/Vector Concatenate1'
 */
        if (rtb_RegenFactor * EvPowertrainController2EM_U.EMSpd[0] >= EvPowertrainController2EM_P.Switch2_Threshold_j) {
            rtb_BrkTrqReqTotal_tmp = EvPowertrainController2EM_P.Constant1_Value_n;
        } else {
            rtb_BrkTrqReqTotal_tmp = EvPowertrainController2EM_P.Constant2_Value_jmm;
        }
        /* {S!d112}Math: '<S38>/Math Function1' */
        if ((rtb_WhlEMTrqMax_tmp < 0.0) && (rtb_BrkTrqReqTotal_tmp > floor(rtb_BrkTrqReqTotal_tmp))) {
            rtb_BrkTrqReqTotal_tmp = -%<(SLibCGCallSubFcn("rt_powd_snf", ["-rtb_WhlEMTrqMax_tmp", "rtb_BrkTrqReqTotal_tmp"], 0, 4, 25))>;
        } else {
            rtb_BrkTrqReqTotal_tmp = %<(SLibCGCallSubFcn("rt_powd_snf", ["rtb_WhlEMTrqMax_tmp", "rtb_BrkTrqReqTotal_tmp"], 0, 4, 10))>;
        }
        rtb_VectorConcatenate1[i + 1] = rtb_RateLimiter_idx_0_tmp * rtb_RegenFactor * rtb_BrkTrqReqTotal_tmp;
    } else {
        /* {S!d114}Product: '<S38>/Product1' incorporates:
 *  Constant: '<S37>/EMTrq Control Vector Traction'
 */
