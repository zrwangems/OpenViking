%endif
%assign incStackBuf = LibEndSharedUtilityFcn("intrp2d_la_pw")
%undef incStackBuf
%undef fcnProPragmaBuf
%undef fcnProBuf
%undef fcnDefBuf
%endif %% !SLibIsFixPtUtilityNameRegistered("intrp2d_la_pw")


